# ==============================================
# 环境变量模板
# ==============================================
# ⚠️ 重要：不要在此文件中填写真实密钥！
# 复制此文件为 .env.local 并填写实际值
# cp env.example .env.local
# ==============================================

# ==============================================
# Next.js 配置
# ==============================================
NEXT_PUBLIC_APP_URL=https://omniflashai.io
NEXT_PUBLIC_BASE_URL=https://omniflashai.io
NODE_ENV=development
NEXT_PUBLIC_PAYMENT_PROVIDERS=dodo
NEXT_PUBLIC_DEFAULT_PAYMENT_PROVIDER=dodo

# ==============================================
# Supabase 配置
# ==============================================
# 从 Supabase Dashboard → Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️ Service Role Key - 仅用于服务端，永远不要暴露到客户端
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================
# Dodo Payments 配置
# ==============================================
# 环境：test_mode 或 live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=dodo_test_your_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=whsec_dodo_your_webhook_secret_here

# 按 pricing plan 配置 Dodo 产品 ID
NEXT_PUBLIC_DODO_PLAN_BASIC_MONTHLY_ID=prod_dodo_basic_monthly
NEXT_PUBLIC_DODO_PLAN_BASIC_YEARLY_ID=prod_dodo_basic_yearly
NEXT_PUBLIC_DODO_PLAN_CREATOR_MONTHLY_V2_ID=prod_dodo_creator_monthly
NEXT_PUBLIC_DODO_PLAN_CREATOR_YEARLY_V2_ID=prod_dodo_creator_yearly
NEXT_PUBLIC_DODO_PLAN_PRO_MONTHLY_ID=prod_dodo_pro_monthly
NEXT_PUBLIC_DODO_PLAN_PRO_YEARLY_ID=prod_dodo_pro_yearly
NEXT_PUBLIC_DODO_PACK_STARTER_ID=prod_dodo_starter_pack
NEXT_PUBLIC_DODO_PACK_CREATOR_ID=prod_dodo_creator_pack
NEXT_PUBLIC_DODO_PACK_DEV_ID=prod_dodo_dev_pack


# ==============================================
# Google OAuth 配置
# ==============================================
# 从 Google Cloud Console → APIs & Services → Credentials 获取
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==============================================
# OpenAI 配置（如果使用）
# ==============================================
OPENAI_API_KEY=sk-your_openai_api_key_here

# ==============================================
# Cloudflare R2 存储配置（如果使用）
# ==============================================
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ==============================================
# 搜索引擎验证（SEO）
# ==============================================
# Google Search Console 验证码
# 从 https://search.google.com/search-console 获取
GOOGLE_SITE_VERIFICATION=RXG1GciT_6Lk-VckDXsTp0wkUZYZfI0RDWy-9D_P-0E

# Bing Webmaster Tools 验证码
# 从 https://www.bing.com/webmasters 获取
# 支持两种验证方式：
# 1. Meta标签验证（推荐）：在Bing Webmaster Tools中选择"添加meta标签"，复制验证码到这里
# 2. XML文件验证：在Bing Webmaster Tools中选择"上传XML文件"，验证码会自动从BingSiteAuth.xml路由读取
BING_VERIFICATION_CODE=your-bing-verification-code

# Yandex Webmaster 验证码（可选）
# 从 https://webmaster.yandex.com 获取
YANDEX_VERIFICATION_CODE=your-yandex-verification-code

# ==============================================
# KIE.ai API 配置
# ==============================================
# KIE API 基础URL（服务器端使用）
KIE_API_BASE_URL=https://api.kie.ai
# KIE API 密钥（服务器端使用，安全）
KIE_API_KEY=your_kie_api_key_here

# 注意：以下客户端配置已移除，改为使用服务器端 API 路由
# NEXT_PUBLIC_API_BASE_URL=https://api.kie.ai
# NEXT_PUBLIC_KIE_API_KEY=your_kie_api_key_here


# ==============================================
# 其他 API 配置
# ==============================================
# 添加其他第三方 API 密钥...
